# Local Ollama model to prefer. Install it manually with:
# ollama pull llama3.1
OLLAMA_MODEL=llama3.1

# Free cloud fallbacks (copy-paste API keys from the providers)
# Put your real values in .env.local, not in this file.
GOOGLE_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# SQLite memory is stored locally in the project folder.
# DATABASE_URL is not needed.
